{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chickadee",
  "version": "0.1.0",
  "identifier": "dev.chickadee.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chickadee",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "visible": false,
        "backgroundColor": "#D9CDB4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../../../dictionary"],
    "copyright": "MIT",
    "category": "Education",
    "shortDescription": "내 리포로 공부하는 학습 앱",
    "longDescription": "바이브 코딩으로 만든 자기 코드를 교재로 삼는 데스크톱 학습 앱."
  },
  "plugins": {}
}
