# ── 커밋 5: 수정 + 삭제 + 진입점 ──────────────────────────────────────────
write src/session/queue.ts <<EOS
import { CardRow, RepoStore } from "../store/repo";
import { clamp, dayKey } from "../core/time";

export const TARGET_MINUTES = 15;
export const MINUTES_PER_CARD = 0.75;
export const MAX_CARDS = 24;

export interface SessionPlan {
  key: string;
  cards: CardRow[];
  minutes: number;
}

function byDue(a: CardRow, b: CardRow): number {
  return a.dueMs - b.dueMs;
}

export function planSession(store: RepoStore, at: Date): SessionPlan {
  const due = store.dueOn(at).sort(byDue);
  const limit = clamp(due.length, 0, MAX_CARDS);
  const picked: CardRow[] = [];
  let minutes = 0;
  for (let i = 0; i < limit; i += 1) {
    const card = due[i];
    if (minutes + MINUTES_PER_CARD > TARGET_MINUTES) {
      break;
    }
    if ((card.lapses ?? 0) > 3) {
      continue;
    }
    picked.push(card);
    minutes += MINUTES_PER_CARD;
  }
  return { key: dayKey(at), cards: picked, minutes };
}

export async function planFresh(
  store: RepoStore,
  at: Date,
  fetch: (id: number) => Promise<CardRow[]>,
): Promise<SessionPlan> {
  await store.reload(fetch);
  return planSession(store, at);
}
EOS
delete src/legacy/oldQueue.ts
write src/index.ts <<EOS
import { RepoStore } from "./store/repo";
import { planFresh } from "./session/queue";
import { dayKey } from "./core/time";

const store = new RepoStore({
  id: 1,
  root: "/fixture/tiny",
  lastIngest: { at: 0, files: 4 },
});

export async function main(now: Date = new Date()): Promise<string> {
  const plan = await planFresh(store, now, async () => [
    { id: 1, conceptId: "ts/optional-chaining", dueMs: now.getTime() },
    { id: 2, conceptId: "ts/async-await", dueMs: now.getTime(), lapses: 1 },
  ]);
  if (plan.cards.length === 0) {
    return dayKey(now) + " · 오늘 인쇄할 카드 없음";
  }
  return plan.key + " · 카드 " + plan.cards.length + " · " + plan.minutes + "분";
}
EOS
