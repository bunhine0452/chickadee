# tiny — 커밋 5, TS 약 200줄 (06 §1.2 · 00 D36)
# CI 통합 잡과 IPC 덤프 골든(fixtures/ipc/tiny/)이 쓰는 기준 픽스처다.
# 평범한 문법을 고르게 담는다: import · const · function · class · async/await ·
# 옵셔널 체이닝 · 반복 · 조건 · 이름 바꾸기 · 삭제.
#
# 형식(자세히는 scripts/make-fixture-repo.sh --help)
#   write <경로> <<EOS ... EOS   파일 통째 쓰기      delete <경로>
#   rename <옛> <새>              이동                commit <메시지...>
#   gen wave <횟수> <경로틀> lines= seed= msg=        결정론적 합성기
# 재생은 scripts/make-fixture-repo.sh tiny — 생성물은 커밋하지 않는다.

# ── 커밋 1 ───────────────────────────────────────────────────────────────
write src/util/time.ts <<EOS
export const DAY_MS = 86_400_000;
export const DAY_START_HOUR = 4;

export interface DayWindow {
  key: string;
  startMs: number;
  endMs: number;
}

export function clamp(value: number, low: number, high: number): number {
  if (value < low) return low;
  if (value > high) return high;
  return value;
}

export function dayKey(at: Date): string {
  const shifted = new Date(at.getTime() - DAY_START_HOUR * 3_600_000);
  const y = shifted.getFullYear();
  const m = String(shifted.getMonth() + 1).padStart(2, "0");
  const d = String(shifted.getDate()).padStart(2, "0");
  return y + "-" + m + "-" + d;
}

export function labelFor(dueMs: number, now: number): string {
  const delta = dueMs - now;
  if (delta < 0) return "지남";
  if (delta < DAY_MS) return "오늘";
  if (delta < DAY_MS * 3) return "곧";
  if (delta < DAY_MS * 14) return "이번 주";
  return "나중";
}

export function windowOf(at: Date): DayWindow {
  const key = dayKey(at);
  const [y, m, d] = key.split("-").map(Number);
  const start = new Date(y, m - 1, d, DAY_START_HOUR, 0, 0, 0);
  return { key, startMs: start.getTime(), endMs: start.getTime() + DAY_MS };
}
EOS
