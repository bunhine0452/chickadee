import { DAY_MS, dayKey, windowOf } from "../core/time";

export interface CardRow {
  id: number;
  conceptId: string;
  dueMs: number;
  lapses?: number;
}

export interface RepoMeta {
  id: number;
  root: string;
  lastIngest?: { at: number; files: number };
}

export class RepoStore {
  private cards = new Map<number, CardRow>();

  constructor(private readonly meta: RepoMeta) {}

  get root(): string {
    return this.meta.root;
  }

  put(row: CardRow): void {
    this.cards.set(row.id, row);
  }

  dueOn(at: Date): CardRow[] {
    const win = windowOf(at);
    const out: CardRow[] = [];
    for (const row of this.cards.values()) {
      if (row.dueMs <= win.endMs) {
        out.push(row);
      }
    }
    return out;
  }

  async reload(fetch: (id: number) => Promise<CardRow[]>): Promise<number> {
    const rows = await fetch(this.meta.id);
    this.cards.clear();
    for (let i = 0; i < rows.length; i += 1) {
      this.put(rows[i]);
    }
    return this.cards.size;
  }

  describe(at: Date): string {
    const seen = this.meta.lastIngest?.files ?? 0;
    const stale = (this.meta.lastIngest?.at ?? 0) < at.getTime() - DAY_MS;
    return dayKey(at) + " · 파일 " + seen + (stale ? " · 갱신 필요" : "");
  }
}
