write src/session/grade.ts <<EOS
import { CardRow } from "../store/repo";

export type Verdict = "exact" | "equiv" | "differ" | "skip";

export interface Judged {
  card: CardRow;
  verdict: Verdict;
  reason?: string;
}

const NORMALIZE = /[;\s]+/g;

export function normalize(src: string): string {
  return src.replace(NORMALIZE, " ").trim();
}

export function judge(card: CardRow, answer: string, original: string): Judged {
  if (answer.length === 0) {
    return { card, verdict: "skip", reason: "빈 답" };
  }
  if (answer === original) {
    return { card, verdict: "exact" };
  }
  if (normalize(answer) === normalize(original)) {
    return { card, verdict: "equiv", reason: "공백·세미콜론만 다름" };
  }
  return { card, verdict: "differ", reason: "토큰 불일치" };
}

export async function judgeAll(
  cards: CardRow[],
  answers: Map<number, string>,
  source: (id: number) => Promise<string>,
): Promise<Judged[]> {
  const out: Judged[] = [];
  for (const card of cards) {
    const original = await source(card.id);
    const answer = answers.get(card.id) ?? "";
    out.push(judge(card, answer, original));
  }
  return out;
}
EOS
