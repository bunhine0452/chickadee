commit feat: 진입점 하나

write src/index.ts <<EOS
export const NAME = "two-commits";
export const VERSION = 2;

export function greet(who?: string): string {
  if (!who) {
    return "안녕, " + NAME;
  }
  return "안녕, " + who + " (v" + VERSION + ")";
}
EOS
commit fix: 빈 이름 분기 처리
