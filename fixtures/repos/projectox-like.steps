write src/features/cart/quantity.ts <<EOS
import { clamp } from "../../core/time";

export const MAX_PER_LINE = 99;

export function nextCount(current: number, delta: number): number {
  return clamp(current + delta, 0, MAX_PER_LINE);
}

export function isAtCeiling(count: number): boolean {
  return count >= MAX_PER_LINE;
}
EOS
write src/features/cart/CartRow.tsx <<EOS
import type { CartLine } from "./cartApi";
import { isAtCeiling, nextCount } from "./quantity";

export interface CartRowProps {
  line: CartLine;
  onChange: (count: number) => void;
}

export function CartRow({ line, onChange }: CartRowProps) {
  const safe = nextCount(line.count, 0);
  return (
    <li className="cart-row">
      <span>{line.sku}</span>
      <button type="button" onClick={() => onChange(nextCount(safe, -1))}>
        빼기
      </button>
      <output>{safe}</output>
      <button
        type="button"
        disabled={isAtCeiling(safe)}
        onClick={() => onChange(nextCount(safe, 1))}
      >
        더하기
      </button>
    </li>
  );
}
EOS
