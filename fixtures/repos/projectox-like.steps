write src/features/cart/cartApi.ts <<EOS
import { DAY_MS } from "../../core/time";
import { MAX_PER_LINE } from "./quantity";

export interface CartLine {
  sku: string;
  count: number;
}

export async function fetchCart(id: string): Promise<CartLine[]> {
  const res = await fetch("/api/cart?id=" + id, { cache: "no-store" });
  if (!res.ok) {
    return [];
  }
  const body = (await res.json()) as { lines?: CartLine[] };
  return (body.lines ?? []).map((line) => ({
    sku: line.sku,
    count: Math.min(line.count, MAX_PER_LINE),
  }));
}

export async function putCount(id: string, sku: string, count: number): Promise<boolean> {
  const res = await fetch("/api/cart", {
    method: "PUT",
    body: JSON.stringify({ id, sku, count }),
  });
  return res.ok;
}

export function staleAfter(at: number): number {
  return at + DAY_MS;
}
EOS
